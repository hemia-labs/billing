{
  "name": "api",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test:authorization:docker": "bash ../../test/api/integration/authorization/authorization-completion.docker.sh",
    "build": "node ./node_modules/.bin/nest build",
    "format": "prettier --write \"src/**/*.ts\" \"../../test/api/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "lint": "cd ../.. && apps/api/node_modules/.bin/eslint --config apps/api/eslint.config.mjs \"apps/api/src/**/*.ts\" \"test/api/**/*.ts\" --fix",
    "test": "node ./node_modules/.bin/jest",
    "test:watch": "node ./node_modules/.bin/jest --watch",
    "test:cov": "node ./node_modules/.bin/jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d data-source.ts",
    "migration:create": "bun run typeorm migration:create",
    "migration:generate": "bun run typeorm migration:generate src/database/migrations/migration",
    "migration:run": "bun run typeorm migration:run",
    "migration:revert": "bun run typeorm migration:revert",
    "seed:run": "ts-node -r tsconfig-paths/register src/database/seeds/billing-catalog.seed.ts",
    "test:redis": "bash ../../test/api/integration/context-cache/system-context-cache.redis.sh",
    "test:bun": "bun test --tsconfig-override ../../test/api/tsconfig.json ../../test/api/unit/copilot/copilot-fevex.test.mjs",
    "test:addon-cancellation:docker": "bash ../../test/api/integration/subscription-addons/subscription-addon-cancellation.docker.sh"
  },
  "dependencies": {
    "@fevex/core": "0.1.0-alpha.3",
    "@fevex/deepseek": "0.1.0-alpha.3",
    "@fevex/openai": "0.1.0-alpha.3",
    "@hemia/auth": "1.0.8",
    "@hemia/event-bus": "0.0.3",
    "@hemia/secrets": "^0.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.2.0",
    "ioredis": "5.11.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "../..",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "<rootDir>/apps/api/node_modules/ts-jest",
        {
          "tsconfig": "<rootDir>/test/api/tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/apps/api/src/$1"
    },
    "collectCoverageFrom": [
      "apps/api/src/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/coverage/api",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test/api/unit"
    ],
    "modulePaths": [
      "<rootDir>/apps/api/node_modules"
    ],
    "moduleDirectories": [
      "<rootDir>/apps/api/node_modules",
      "node_modules"
    ]
  }
}
