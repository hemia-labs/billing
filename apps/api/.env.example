NODE_ENV=development
PORT=3015
APP_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5175,http://localhost:3015
AUTH_ISSUER_URL=
AUTH_JWKS_URI=
AUTH_AUDIENCE=
AUTH_REQUIRED_ISSUER=

REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_DB=0
SSO_ISSUER=http://localhost:3002
SSO_CLIENT_ID=billing-web
SSO_CLIENT_SECRET=
SSO_AUDIENCE=billing-api
SSO_JWKS_URL=
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_REVOCATION_URL=
SSO_LOGOUT_URL=
SSO_REDIRECT_URI=http://localhost:3015/auth/callback
SSO_FRONTEND_URL=http://localhost:5175
SSO_SCOPE=openid profile email offline_access billing.access
SSO_COOKIE_NAME=billing_session
SSO_SESSION_TTL_SECONDS=604800
SSO_COOKIE_SECURE=false
PRODUCT_CODE=billing
ACCESS_API_URL=http://localhost:3019
ACCESS_JWKS_URI=http://localhost:3019/.well-known/jwks.json
ACCESS_AUDIENCE=access-api

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=
PAYPAL_MEDSYNC_BASIC_PLAN_ID=
PAYPAL_MEDSYNC_PRO_PLAN_ID=
PAYPAL_MEDSYNC_CLINIC_PLAN_ID=
PAYPAL_MEDSYNC_EXTRA_USER_PLAN_ID=

HEMIA_LEGAL_BASE_URL=
HEMIA_LEGAL_TOKEN_URL=http://localhost:4000/oauth/token
HEMIA_LEGAL_CLIENT_ID=billing-legal-service
HEMIA_LEGAL_CLIENT_SECRET=
# productCode -> issuerId/applicationId (real Legal UUIDs)
HEMIA_LEGAL_PRODUCTS={}

BILLING_FISCAL_PROVIDER=noop
BILLING_FISCAL_API_BASE_URL=
BILLING_FISCAL_API_KEY=
BILLING_FISCAL_STORAGE_ENDPOINT=
BILLING_FISCAL_STORAGE_BUCKET=
BILLING_FISCAL_STORAGE_ACCESS_KEY_ID=
BILLING_FISCAL_STORAGE_SECRET_ACCESS_KEY=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_LOGGING=false

# Vault: enable to load database/postgres, cache/redis and SECRETS_SSO_PATH.
SECRETS_ENABLED=false
SECRETS_ENVIRONMENT=dev
SECRETS_CATEGORY=internal
SECRETS_OWNER=hemia
SECRETS_SYSTEM=billing
# Relative path within the billing scope.
SECRETS_SSO_PATH=auth/sso
VAULT_BASE_URL=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_AUTH_PATH=approle
VAULT_MOUNT_PREFIX=kv-
VAULT_TIMEOUT_MS=5000
SECRETS_CACHE_ENABLED=false
SECRETS_CACHE_TTL_MS=60000

# Access event notifications (mandatory in production). Dedicated Billing Redis DB.
EVENT_BUS_ENABLED=false
EVENT_BUS_PREFETCH=10
AMQP_URL=amqp://localhost:5672

# Private operational listener. Set port and a >=32-character random token to enable.
# Use the deployment secret manager; do not expose this port publicly.
METRICS_PORT=
METRICS_HOST=127.0.0.1
METRICS_TOKEN=
