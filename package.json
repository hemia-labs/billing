{
  "name": "nextjs-nestjs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api start:dev",
    "test": "bun run --cwd apps/api test && bun run --cwd apps/api test:bun && bun run --cwd apps/web test",
    "test:api": "bun run --cwd apps/api test",
    "test:web": "bun run --cwd apps/web test",
    "test:payments": "bun run --cwd packages/payments build && bun run --cwd packages/payments test",
    "changeset": "changeset",
    "version:payments": "node scripts/version-payments.mjs",
    "test:release": "node --test test/release/payments-release.test.mjs",
    "test:payments:tarball": "node test/payments/package/check-payments-tarball.mjs"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@changesets/cli": "2.31.1"
  }
}
