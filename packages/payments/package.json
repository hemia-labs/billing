{
  "name": "@hemia/payments",
  "version": "0.10.0",
  "description": "Server-side Hemia payments integration client",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.cjs",
    "prepack": "npm run build",
    "test:nest": "NODE_PATH=../../apps/api/node_modules node --test test/nest/*.test.cjs"
  },
  "peerDependencies": {
    "@hemia/auth": "^1.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "typeorm": ">=0.3.0 <2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@hemia/auth": "1.1.0",
    "typescript": "^5.7.3",
    "@types/node": "^24.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "author": "Hemia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemia-labs/billing.git",
    "directory": "packages/payments"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
