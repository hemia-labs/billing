{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@nestjs/*": [
        "../../apps/api/node_modules/@nestjs/*"
      ],
      "typeorm": [
        "../../apps/api/node_modules/typeorm"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
