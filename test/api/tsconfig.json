{
  "extends": "../../apps/api/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "../../apps/api",
    "paths": {
      "*": [
        "node_modules/*"
      ],
      "@hemia/secrets/nestjs": [
        "node_modules/@hemia/secrets/dist/nestjs/index.d.ts"
      ],
      "supertest": [
        "node_modules/@types/supertest/index.d.ts"
      ],
      "supertest/types": [
        "node_modules/@types/supertest/types.d.ts"
      ]
    },
    "types": [
      "node",
      "jest"
    ],
    "typeRoots": [
      "../../apps/api/node_modules/@types",
      "../../node_modules/@types"
    ],
    "incremental": false
  },
  "include": [
    "unit/**/*.ts"
  ]
}
